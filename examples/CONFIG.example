#!/usr/bin/bash

# Example CONFIG for post_rnadnavar_mupexi_prep.
# Workflow names:
# - RNA steps:  rna1 .. rna7
# - gDNA steps: gdna1 .. gdna4

# SAMPLES file: first column is sample ID with suffix label, e.g.
#   Pat1_DNA_NORMAL
#   Pat1_DNA_TUMOR
#   Pat1_RNA_TUMOR
samples="/path/to/SAMPLES.tsv"

# Working directories
vcfdir="/path/to/project/variant_calling/mutect2"
bamdir="/path/to/project/preprocessing/markduplicates"
dna_bam_suffix="md.bam"
# Optional upstream rnadnavar roots for cleanup/BAM-adjacent STAR outputs.
# recaldir="/path/to/project/preprocessing/recalibrated"

# Optional splicing-specific STAR reports root.
# Use this when SJ.out.tab and Log.* outputs live under rnadnavar reports/star, e.g.
#   /path/to/project/data/rna/rnadnavar/reports/star/Pat101/RNA_TUMOUR/RNA_TUMOUR.0001.SJ.out.tab
# splicing_sjdir="/path/to/project/data/rna/rnadnavar/reports/star"
# Optional splicing output root for spl2/spl3/spl3.5/spl4 TSVs, FASTA files, and splicing logs.
# If unset and datadir is defined, spl2, spl3, spl3.5, and spl4 default to ${datadir}/splicing.
# splicing_outdir="/path/to/project/data/rna/rnadnavar/splicing"
# spl2/spl3/spl3.5/spl4 write patient-scoped outputs under ${splicing_outdir}/${patient}_RNA_${tumor_tag}.
# Optional normal splice-junction reference for spl3.5 filtering. This should be
# a compact TSV/TSV.GZ already normalized to the same genome build and coordinate
# convention as spl3. Required columns: chrom, left_boundary/start,
# right_boundary/end, and optionally strand. Useful optional columns:
# normal_sample_count/gtex_sample_count/sample_count, normal_total_reads,
# normal_prevalence/gtex_prevalence, source.
# splicing_normal_junction_ref="/path/to/normal_splice_junction_reference.tsv.gz"
# Optional names for build-specific normal references before/after liftover.
# splicing_normal_junction_ref_grch37="/path/to/normal_splice_junction_reference.GRCh37.tsv.gz"
# splicing_normal_junction_ref_grch38="/path/to/normal_splice_junction_reference.GRCh38.tsv.gz"
# splicing_liftover_chain="/path/to/hg19ToHg38.over.chain.gz"
# Default is pure Python chain parsing, so no UCSC liftOver binary is required.
# Set splicing_liftover_engine="ucsc" only if you have a compatible UCSC liftOver binary.
# splicing_liftover_engine="python"
# splicing_liftover_bin="liftOver"
# splicing_normal_max_prevalence="0.01"
# splicing_normal_total_samples="9166"
# If spl3.5 is used, make spl4 read the filtered cancer-unique file:
# splicing_spl4_input_suffix=".spl3.5.cancer_unique.tsv"
# Optional one-time Snaptron normal-reference build resources.
# splicing_reference_modules="tools anaconda3/2025.06-1"
# splicing_reference_qsub_nodes="1"
# splicing_reference_qsub_ppn="2"
# splicing_reference_qsub_mem="32gb"
# splicing_reference_qsub_walltime="24:00:00"
# splicing_liftover_modules="tools anaconda3/2025.06-1"
# splicing_liftover_qsub_nodes="1"
# splicing_liftover_qsub_ppn="2"
# splicing_liftover_qsub_mem="32gb"
# splicing_liftover_qsub_walltime="24:00:00"

# Helper scripts directory (inside this repo).
rnae_scripts="/path/to/this/repo/post_rnadnavar_mupexi_prep/rnae_script"

# Optional PBS defaults
qsub_group="srhgroup"
qsub_account="srhgroup"

# References
knownsites="/path/to/KnownSites_merged.with_source.collapsed.clean.tsv.gz"
FASTA="/path/to/reference.fa.gz"
DICT="/path/to/reference.dict"
GTF="/path/to/gencode.annotation.gtf.gz"

# Standardized cohort tags. Change these once if your cohort uses another
# spelling, e.g. tumor_tag="T", tumor_tag="t", or tumor_tag="TUMOUR".
normal_tag="NORMAL"
tumor_tag="TUMOR"

# Label variables used for matching sample suffixes in SAMPLES/VCF/BAM headers.
dna_normal_label="DNA_${normal_tag}"
dna_tumor_label="DNA_${tumor_tag}"
rna_tumor_label="RNA_${tumor_tag}"

# Standardized output names for merged outputs.
out_dna_normal_label="${dna_normal_label}"
out_dna_tumor_label="${dna_tumor_label}"
out_rna_tumor_label="${rna_tumor_label}"

# gDNA output suffixes
# Expected under: ${vcfdir}/${patient}_${out_dna_normal_label}/
gdna1_vcf_extension="gdna1.HaplotypeCaller.vcf"
gdna2_vcf_extension="gdna2.Filtered.HaplotypeCaller.vcf"
gdna3_vcf_extension="gdna3.Filtered.Selected.HaplotypeCaller.vcf"
gdna4_vcf_extension="gdna4.Filtered.vcf"

# Which gDNA VCF suffix rna6 should merge (defaults to gdna4_vcf_extension).
ndna_vcf="${gdna4_vcf_extension}"
# Optional override for research samecopy stats germline input suffix.
# Default resolution: samecopy_germline_vcf_extension -> ndna_vcf -> gdna4_vcf_extension -> gdna3_vcf_extension
# samecopy_germline_vcf_extension="${ndna_vcf}"

# gDNA filtering knobs
germline_min_dp=10
germline_min_qd=2.0
germline_proximity_distance=33

# gdna4 RNA-proximity source control:
# - auto (recommended): include RNA proximity when RNA VCF is found
# - 1: require attempt, warn+fallback to DNA-only if RNA VCF missing
# - 0: DNA-only
germline_include_rna_proximity="auto"
# Optional explicit override (supports {patient} placeholder):
# germline_rna_proximity_vcf="/path/to/{patient}_rna5.knownsites_summarised_qced.vcf.gz"
# Optional extension override in patient RNA-vs-normal folder:
# germline_rna_proximity_vcf_extension="rna5.knownsites_summarised_qced.vcf.gz"

# RNA output suffixes
# Expected under: ${vcfdir}/${patient}_${out_rna_tumor_label}_vs_${patient}_${out_dna_normal_label}/
# Upstream mutect2 VCF suffixes produced by rnadnavar (inputs to rna1 and gdna1):
# Full source path pattern used by rna1:
#   RNA source: ${vcfdir}/${patient}_${out_rna_tumor_label}_vs_${patient}_${out_dna_normal_label}/${patient}_${source_rna_mutect2_vcf_extension}
#   DNA source: ${vcfdir}/${patient}_${out_dna_tumor_label}_vs_${patient}_${out_dna_normal_label}/${patient}_${source_dna_mutect2_vcf_extension}
# You can use "{patient}" placeholder in these suffixes.
source_rna_mutect2_vcf_extension="${out_rna_tumor_label}_vs_{patient}_${out_dna_normal_label}.mutect2.filtered.vcf.gz"
source_dna_mutect2_vcf_extension="${out_dna_tumor_label}_vs_{patient}_${out_dna_normal_label}.mutect2.filtered.vcf.gz"

# RNA pipeline outputs
rna1_vcf_extension="rna1.filtered_minus_dna_positions.vcf.gz"
rna2_split_vcf_extension="rna2.filtered_minus_dna_positions.split.vcf.gz"
rna2_labeled_vcf_extension="rna2.filtered_edit_labeled.vcf.gz"
rna3_knownsites_vcf_extension="rna3.filtered_edit_labeled.knownsites.vcf.gz"
rna4_summarised_vcf_extension="rna4.filtered_edit_labeled.knownsites_summarised.vcf.gz"
rna5_qced_vcf_extension="rna5.filtered_edit_labeled.knownsites_summarised_qced.vcf.gz"
rna5_stranded_vcf_extension="rna5.1.filtered_edit_labeled.knownsites_summarised_qced_stranded.vcf.gz"
rna6_merged_vcf_extension="rna6.DNAt_DNAn_RNAt_merged.vcf.gz"
rna7_genotyped_vcf_extension="rna7.DNAt_DNAn_RNAt_merged_genotyped.vcf.gz"
rna7_phased_vcf_extension="rna7.DNAt_DNAn_RNAt_merged_phased.vcf.gz"
rna7_signal_sample_label="TUMOR"

# RNA strandedness filter (rna5.1)
# Expected library orientation from RSeQC infer_experiment.py:
#   fr-firststrand  -> dominant 1+-,1-+,2++,2--
#   fr-secondstrand -> dominant 1++,1--,2+-,2-+
rna_strand_protocol="fr-firststrand"
rna_strand_min_mapq="20"
rna_strand_min_baseq="20"
rna_strand_min_expected_frac="0.8"
rna_strand_threads="4"

# Required rna7.0 output suffix (rna7 consumes this BAM)
rna7_smfixed_bam_suffix="RNA_TUMOUR.md.SMfixed.bam"

# Optional module profile override (wrappers default to REPO/pipeline_defaults/toolchain.defaults.sh).
# You can define these in CONFIG to override repo defaults:
# module_gatk="gatk/4.5.0.0"
# modules_rna="ngs tools htslib/1.23 bcftools/1.23 ${module_gatk} anaconda3/2025.06-1"
# modules_gdna_hc="tools ngs ${module_htslib} samtools/1.23 java/17-openjdk ${module_gatk}"
# splicing_module_prereq="tools"
# splicing_python_modules="anaconda3/2025.06-1"
# splicing_qsub_nodes="1"
# splicing_qsub_ppn="2"
# splicing_qsub_mem="16gb"
# splicing_qsub_walltime="06:00:00"
# Optional spl3-specific qsub overrides; otherwise spl3 uses splicing_qsub_*.
# splicing_spl3_qsub_nodes="1"
# splicing_spl3_qsub_ppn="2"
# splicing_spl3_qsub_mem="16gb"
# splicing_spl3_qsub_walltime="06:00:00"
# Optional spl4-specific qsub overrides; otherwise spl4 uses splicing_qsub_*.
# splicing_spl4_qsub_nodes="1"
# splicing_spl4_qsub_ppn="2"
# splicing_spl4_qsub_mem="24gb"
# splicing_spl4_qsub_walltime="08:00:00"

# DNA-only path (no RNA): merge germline + DNA somatic, then genotype/phase DNA tumor
# If unset, defaults are used by dna_only_merge_and_phase.sh.
# germline_for_merge_extension defaults to gdna4_vcf_extension (or output_extension_30 in legacy config).
dna_only_merged_vcf_extension="dna_only6.DNAt_DNAn_merged.vcf.gz"
dna_only_genotyped_vcf_extension="dna_only7.DNAt_DNAn_merged_genotyped.vcf.gz"
dna_only_phased_vcf_extension="dna_only7.DNAt_DNAn_merged_phased.vcf.gz"
# dna_only_genotyper_mode: safe|auto|hc
# safe (recommended): no HaplotypeCaller, composes tumor genotype from merged VCF with hard validation.
# auto: try HaplotypeCaller then fallback to safe if HC crashes.
# hc: require HaplotypeCaller success.
dna_only_genotyper_mode="safe"

# MuPeXI2 integration
mupexi2_repo="/home/projects/SRHgroup/apps/mupexi2"
mupexi_outdir="/path/to/project/mupexi2"
mupexi_netmhc_config="/home/projects/SRHgroup/apps/netMHCpan/4.0a/config.computerome.ini"
# Mosdepth reports root used by research run_mosdepth_overlap
mosdepthdir="/path/to/project/reports/mosdepth"
fus_dir="${datadir}/arriba"
hladir="${datadir}/hla"

# Sample names in merged phased VCF
mupexi_tumor_sample="TUMOR"
mupexi_normal_sample="DNA_NORMAL"
# DNA-only MuPeXI runs default to the same tumor sample name as RNA+DNA mode.
# Override only if your DNA-only phased VCF uses a different tumor sample column, e.g. DNA_TUMOR.
# mupexi_dna_only_tumor_sample="${out_dna_tumor_label}"

# MuPeXI behavior
mupexi_peptide_lengths="9-11"
# Keep MuPeXI default behavior unless you explicitly disable it.
mupexi_parallel_k="true"
mupexi_enable_germlines="true"
mupexi_enable_superpeptides="true"
mupexi_enable_rna_edit="true"
# MuPeXI qsub resources (overridable via run_pipeline mupexi --nodes/--ppn/--mem/--walltime)
mupexi_qsub_nodes="1"
# If unset, ppn defaults to count of unique K values from mupexi_peptide_lengths (e.g. 9-11 -> 3).
# mupexi_qsub_ppn="3"
mupexi_qsub_mem="24gb"
mupexi_qsub_walltime="24:00:00"

# Cleanup qsub resources (overridable via run_pipeline cleanup --nodes/--ppn/--mem/--walltime)
# cleanup_qsub_nodes="1"
# cleanup_qsub_ppn="8"
# cleanup_qsub_mem="32gb"
# cleanup_qsub_walltime="24:00:00"

# HLA is read per patient from hladir.
# Supported layouts:
#   Legacy flat file:
#     ${hladir}/${patient}_hla1.tab
#   nf-core hlatyping / OptiType:
#     ${hladir}/optitype/${patient}_NORMAL/<result.tsv>
# hladir may point either to the old HLA folder or directly to .../hla/nf-core-hlatyping.
# Optional override for direct suffix:
# mupexi_hla_direct_extension="hla1.tab"
# Default suffix uses output_extension_14 when present.
# mupexi_hla_extension="${output_extension_14}"
#
# Expression defaults are resolved from existing expression pipeline outputs:
#   ${kaldir}/${patient}_${output_extension_14}
# If the file is missing, MuPeXI still runs (without -e).
# Full-cohort launcher mode is auto-detected from SAMPLES:
#   RNA_TUMOR present -> use rna7_phased_vcf_extension + optional expression/fusions
#   no RNA_TUMOR      -> use dna_only_phased_vcf_extension and disable RNA/fusion inputs
# Optional fusion map override:
# mupexi_fusion_arriba_map_tsv="/path/to/mupexi_fusion_arriba_map.tsv" # patient<TAB>fusion_arriba_path
# MuPeXI2 -S neosplicing inputs are discovered from splicing_outdir
# or, if unset, from ${datadir}/splicing. Do not define a separate MuPeXI
# splicing location.

# Samecopy/RNA-edit research VEP source (per-patient files like Pat11_vep.vep).
# samecopy_vep_dir="${datadir}/mupexi2"

# Module stacks for research/MuPeXI jobs are defined in pipeline_defaults/toolchain.defaults.sh.
